{
  "manifest_version": 3,
  "name": "Limitr",
  "short_name": "Limitr",
  "version": "2.1.4",
  "author": "Ozan Karaali",
  "description": "Tames sudden loud spikes — alerts, yelling, explosions — so you can watch and sleep in peace",
  "browser_specific_settings": {
    "gecko": {
      "id": "limitr@ozankaraali.dev",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "permissions": [
    "storage",
    "tabCapture",
    "offscreen",
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/toolbar-off-16.png",
      "32": "icons/toolbar-off-32.png",
      "48": "icons/toolbar-off-48.png",
      "128": "icons/toolbar-off-128.png"
    }
  },
  "icons": {
    "16": "icons/app-16.png",
    "32": "icons/app-32.png",
    "48": "icons/app-48.png",
    "128": "icons/app-128.png"
  },
  "background": {
    "scripts": ["lib/settings.js", "background.js"],
    "preferred_environment": ["service_worker", "document"],
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/settings.js", "content-bridge.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["lib/engine.js", "content-audio.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true,
      "world": "MAIN"
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/dsp-worklet.js",
        "lib/noise-suppressor-worklet.js",
        "lib/rnnoise.wasm",
        "lib/transcriber-capture-worklet.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
