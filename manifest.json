{
  "manifest_version": 3,
  "name": "Limitr",
  "short_name": "Limitr",
  "version": "1.1.0",
  "author": "Ozan Karaali",
  "description": "Audio compressor, limiter, and normalizer for any browser tab",
  "browser_specific_settings": {
    "gecko": {
      "id": "limitr@ozankaraali.dev",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "storage",
    "tabCapture",
    "offscreen",
    "tabs",
    "scripting",
    "contextMenus"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16-gray.png",
      "32": "icons/icon32-gray.png",
      "48": "icons/icon48-gray.png",
      "128": "icons/icon128-gray.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "scripts": ["background.js"],
    "preferred_environment": ["service_worker", "document"],
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "lib/noise-suppressor-worklet.js",
        "lib/peak-guard-worklet.js",
        "lib/rnnoise.wasm",
        "lib/transformers.min.js",
        "lib/transcriber.js",
        "lib/transcriber-qwen3.js",
        "lib/qwen3-asr-wasm.js",
        "lib/qwen3-asr-wasm.wasm",
        "lib/ort.bundle.min.mjs",
        "lib/ort-wasm-simd-threaded.jsep.wasm",
        "lib/ort-wasm-simd-threaded.jsep.mjs",
        "lib/transcriber-capture-worklet.js"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}
